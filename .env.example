# Scoring engine: "api" uses the OpenAI-compatible endpoint below;
# "devin"/"claude"/"codex"/"opencode"/"cmdc" shell out to that agentic CLI
# instead (no API key needed). Run `ta engines` to see which are installed.
TA_CLI_ENGINE=api
# Optional: model / reasoning effort for the CLI engine — mapped per engine:
# devin --model; claude --model/--effort; codex -m/-c model_reasoning_effort;
# opencode -m/--variant; cmdc -m/--effort. Empty = the CLI's own default.
# TA_CLI_MODEL=
# TA_CLI_EFFORT=high
# Optional: custom grader command overriding the engine presets; must contain
# {prompt_file} and print the scoring JSON on stdout.
# TA_GRADER_CMD=opencode run "$(cat {prompt_file})"

# LLM — OpenRouter (https://openrouter.ai). Required only when TA_CLI_ENGINE=api.
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=sk-or-v1-...
TA_MODEL=qwen/qwen3.5-397b-a17b

# PKU IAAA credentials (your PKU student/staff ID and password)
PKU_USERNAME=2300012345
PKU_PASSWORD=your_password
# Alternative: browser session cookie, skipping IAAA login entirely — useful
# when the account requires OTP or is rate-limited. Copy the `Cookie:` request
# header from DevTools → Network → any course.pku.edu.cn request, then EITHER
# save it verbatim into a `.bb_cookie` file next to main.py (recommended —
# long values break .env parsing), or inline it as BB_COOKIE=...
# BB_COOKIE_FILE=.bb_cookie
# BB_COOKIE=JSESSIONID=...; session_id=...; ...

# Blackboard course ID — found in the URL of any course page, e.g. _98024_1
COURSE_ID=_98024_1

# Optional: pre-set a student whitelist (comma-separated IDs); empty = all students
# STUDENT_WHITELIST=2100012345,2100012346

# Optional: confidence threshold below which a score is flagged for human review (default 0.75)
# REVIEW_THRESHOLD=0.75

# Optional: disable chain-of-thought thinking tokens for Qwen3 models (faster + cheaper)
# ENABLE_THINKING=false

# Optional: number of parallel scoring threads (default 4)
# TA_THREADS=4
